# BloodLink Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials

# Neon PostgreSQL Database Credentials
DATABASE_URL=jdbc:postgresql://<neon-host>:5432/<database-name>?sslmode=require
DATABASE_USERNAME=<neon-username>
DATABASE_PASSWORD=<neon-password>

# JWT Configuration
# 256-bit or stronger hex/base64 secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiration in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Client & CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Real-time WebSocket Endpoint
WEBSOCKET_URL=http://localhost:8080/ws
