# BloodLink Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# Server Port
PORT=8080

# Neon PostgreSQL Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>:5432/<database-name>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-username>
SPRING_DATASOURCE_PASSWORD=<neon-password>

# JWT Configuration (64+ character random hex string)
JWT_SECRET=<generate-a-random-64-character-hex-string>
JWT_EXPIRATION=86400000

# Client & CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo Data Seeding (false for production)
SEED_DEMO_DATA=false

# Matching Engine Radius (in km)
MATCHING_RADIUS_KM=50.0
