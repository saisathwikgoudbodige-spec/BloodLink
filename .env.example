# BloodLink Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — it is in .gitignore.

# ============================================================
# Neon PostgreSQL Database Credentials
# Obtain from your Neon dashboard: https://console.neon.tech/
# ============================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<neon-database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-username>
SPRING_DATASOURCE_PASSWORD=<neon-password>

# ============================================================
# JWT Security
# Generate a strong random secret: use 64+ hex characters.
# Example (Linux): openssl rand -hex 64
# Example (Windows): [System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64) | ForEach-Object { '{0:x2}' -f $_ }
# ============================================================
JWT_SECRET=<generate-a-random-64-character-hex-string>
JWT_EXPIRATION=86400000

# ============================================================
# Client & CORS Configuration
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Docker Compose Frontend Build (only needed for local Docker)
# ============================================================
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws

# ============================================================
# Demo Data Seeding
# Set to false in production to skip demo accounts.
# ============================================================
SEED_DEMO_DATA=true

# ============================================================
# Optional Matching Engine
# ============================================================
MATCHING_RADIUS_KM=50.0
